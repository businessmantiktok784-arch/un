# Supabase credentials (required)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Google AdSense (required for ads to go live)
# Set to your Publisher ID from https://www.google.com/adsense
# Example: VITE_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
# Leave empty to show placeholder "Ad space" indicators instead of real ads.
# VITE_ADSENSE_CLIENT=""
